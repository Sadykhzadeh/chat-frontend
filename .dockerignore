# Without this, `COPY . .` dragged the host's node_modules and .next into the
# build context and over the top of the installed ones.
.git
.gitignore
node_modules
.next
out
Dockerfile
.dockerignore
docker-compose.yaml
README.md
npm-debug.log*
yarn-error.log*
.env*
.vercel
# generated by next-pwa into public/
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/worker-*.js.map
